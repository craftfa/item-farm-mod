package com.itemfarm.blockentity;

import com.itemfarm.ItemFarmMod;
import com.itemfarm.block.ModBlocks;
import net.fabricmc.fabric.api.object.builder.v1.block.entity.FabricBlockEntityTypeBuilder;
import net.minecraft.block.entity.BlockEntityType;
import net.minecraft.registry.Registries;
import net.minecraft.registry.Registry;
import net.minecraft.util.Identifier;

public class ModBlockEntities {

    public static BlockEntityType<ItemFarmBlockEntity> ITEM_FARM_BLOCK_ENTITY;

    public static void register() {
        ITEM_FARM_BLOCK_ENTITY = Registry.register(
            Registries.BLOCK_ENTITY_TYPE,
            Identifier.of(ItemFarmMod.MOD_ID, "item_farm"),
            FabricBlockEntityTypeBuilder.create(ItemFarmBlockEntity::new, ModBlocks.ITEM_FARM).build()
        );
    }
}
