package com.itemfarm.block;

import com.itemfarm.blockentity.ItemFarmBlockEntity;
import com.itemfarm.blockentity.ModBlockEntities;
import net.minecraft.block.*;
import net.minecraft.block.entity.BlockEntity;
import net.minecraft.block.entity.BlockEntityTicker;
import net.minecraft.block.entity.BlockEntityType;
import net.minecraft.entity.player.PlayerEntity;
import net.minecraft.item.ItemStack;
import net.minecraft.nbt.NbtCompound;
import net.minecraft.screen.NamedScreenHandlerFactory;
import net.minecraft.state.StateManager;
import net.minecraft.state.property.BooleanProperty;
import net.minecraft.state.property.Properties;
import net.minecraft.util.ActionResult;
import net.minecraft.util.Hand;
import net.minecraft.util.ItemScatterer;
import net.minecraft.util.hit.BlockHitResult;
import net.minecraft.util.math.BlockPos;
import net.minecraft.world.World;
import org.jetbrains.annotations.Nullable;

public class ItemFarmBlock extends BlockWithEntity {

    public static final BooleanProperty POWERED = Properties.POWERED;

    public ItemFarmBlock(Settings settings) {
        super(settings);
        setDefaultState(getStateManager().getDefaultState().with(POWERED, false));
    }

    @Override
    protected void appendProperties(StateManager.Builder<Block, BlockState> builder) {
        builder.add(POWERED);
    }

    @Nullable
    @Override
    public BlockEntity createBlockEntity(BlockPos pos, BlockState state) {
        return new ItemFarmBlockEntity(pos, state);
    }

    @Override
    public BlockRenderType getRenderType(BlockState state) {
        return BlockRenderType.MODEL;
    }

    // Detectar señal Redstone
    @Override
    public void neighborUpdate(BlockState state, World world, BlockPos pos,
                               Block sourceBlock, BlockPos sourcePos, boolean notify) {
        if (!world.isClient) {
            boolean powered = world.isReceivingRedstonePower(pos);
            boolean wasPowered = state.get(POWERED);

            if (powered != wasPowered) {
                world.setBlockState(pos, state.with(POWERED, powered));
                if (powered) {
                    // Al recibir señal Redstone, generamos los items
                    BlockEntity be = world.getBlockEntity(pos);
                    if (be instanceof ItemFarmBlockEntity farmBE) {
                        farmBE.generateItems(world, pos);
                    }
                }
            }
        }
    }

    // Clic derecho: colocar el item a farmear
    @Override
    public ActionResult onUse(BlockState state, World world, BlockPos pos,
                              PlayerEntity player, Hand hand, BlockHitResult hit) {
        if (!world.isClient) {
            BlockEntity be = world.getBlockEntity(pos);
            if (be instanceof ItemFarmBlockEntity farmBE) {
                ItemStack heldStack = player.getStackInHand(hand);

                if (farmBE.getTargetItem().isEmpty() && !heldStack.isEmpty()) {
                    // Si no tiene item configurado, lo asignamos con 1 item del jugador
                    ItemStack toStore = heldStack.copy();
                    toStore.setCount(1);
                    farmBE.setTargetItem(toStore);
                    heldStack.decrement(1);
                    farmBE.markDirty();
                    player.sendMessage(net.minecraft.text.Text.literal(
                        "§a¡Granja configurada para: §e" +
                        toStore.getName().getString()), true);
                } else if (!farmBE.getTargetItem().isEmpty() && heldStack.isEmpty()) {
                    // Si tiene item y la mano está vacía, lo devolvemos
                    player.giveItemStack(farmBE.getTargetItem().copy());
                    farmBE.setTargetItem(ItemStack.EMPTY);
                    farmBE.markDirty();
                    player.sendMessage(net.minecraft.text.Text.literal(
                        "§cGranja reiniciada."), true);
                } else if (!farmBE.getTargetItem().isEmpty()) {
                    player.sendMessage(net.minecraft.text.Text.literal(
                        "§7Farmeando: §e" + farmBE.getTargetItem().getName().getString() +
                        " §7| Genera §b" + farmBE.getGenerateAmount() + " §7por pulso Redstone"), true);
                }
            }
        }
        return ActionResult.SUCCESS;
    }

    // Al romper el bloque, dropeamos el item configurado
    @Override
    public void onStateReplaced(BlockState state, World world, BlockPos pos,
                                BlockState newState, boolean moved) {
        if (!state.isOf(newState.getBlock())) {
            BlockEntity be = world.getBlockEntity(pos);
            if (be instanceof ItemFarmBlockEntity farmBE) {
                if (!farmBE.getTargetItem().isEmpty()) {
                    ItemScatterer.spawn(world, pos, net.minecraft.inventory.SimpleInventory.createDefault(1));
                    ItemScatterer.spawn(world,
                        pos.getX(), pos.getY(), pos.getZ(),
                        farmBE.getTargetItem());
                }
            }
            super.onStateReplaced(state, world, pos, newState, moved);
        }
    }

    @Nullable
    @Override
    public <T extends BlockEntity> BlockEntityTicker<T> getTicker(World world, BlockState state,
                                                                   BlockEntityType<T> type) {
        return null; // No necesitamos tick continuo, solo respondemos al Redstone
    }
}
